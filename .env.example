# Claude models run on your Claude subscription through the Claude Agent SDK:
# log in once with `claude` (Claude Code) on this machine and no key is
# needed. Every other model goes through OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# SQLite location (libsql URL). Default is a local file.
DATABASE_URL=file:./data/rendr.db

# Pieces run in a sandbox on a second origin. Defaults to the other loopback
# name in development; set explicitly when deployed.
# NEXT_PUBLIC_SANDBOX_ORIGIN=https://sandbox.example.com
# RENDR_HOST_ORIGINS=https://rendr.example.com

# Append every raw model text delta to data/stream-<chat>.log (debugging
# specs that fail to render).
# RENDR_DEBUG_STREAM=1
# Append every Claude Agent SDK message to data/claude-events.log.
# RENDR_DEBUG_CLAUDE=1

# Research providers (optional). With none set, DuckDuckGo + fetch are used.
# BRAVE_API_KEY=
# TAVILY_API_KEY=
